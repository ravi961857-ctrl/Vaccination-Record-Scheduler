<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VaxTrack – Patient & Vaccine Management</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  --mint:#00c9a7;--mint-lt:#e6faf6;--mint-dk:#00967d;--mint-mid:#a0e8d8;
  --navy:#0b1f3a;--navy2:#162d4e;--navy3:#1e3a5f;
  --amber:#f59e0b;--amber-lt:#fef3c7;
  --rose:#f43f5e;--rose-lt:#fff1f4;
  --purple:#7c3aed;--purple-lt:#f5f3ff;
  --green:#10b981;--green-lt:#ecfdf5;
  --text:#0b1f3a;--text2:#4a5568;--text3:#94a3b8;
  --card:#fff;--bg:#f1f5fb;--bg2:#f8fafc;
  --border:#e2e8f0;--border2:#cbd5e1;
  --font:'Inter',sans-serif;--serif:'Playfair Display',serif;
  --r:12px;--shadow:0 1px 12px rgba(11,31,58,.07);--shadow2:0 8px 40px rgba(11,31,58,.14);
  --sidebar:256px;--topbar:60px;
}
html{scroll-behavior:smooth}
body{font-family:var(--font);background:var(--bg);color:var(--text);font-size:14px;line-height:1.5;min-height:100vh}

/* ── LAYOUT ── */
.app{display:flex;min-height:100vh}
.sidebar{width:var(--sidebar);background:var(--navy);display:flex;flex-direction:column;position:fixed;inset:0 auto 0 0;z-index:50;overflow-y:auto;transition:transform .3s}
.main{margin-left:var(--sidebar);flex:1;display:flex;flex-direction:column;min-height:100vh}

/* ── SIDEBAR ── */
.logo{padding:22px 20px 16px;border-bottom:1px solid rgba(255,255,255,.07)}
.logo-row{display:flex;align-items:center;gap:10px}
.logo-mark{width:36px;height:36px;background:var(--mint);border-radius:10px;display:flex;align-items:center;justify-content:center}
.logo-mark i{color:#fff;font-size:16px}
.logo-text{font-size:20px;font-weight:700;color:#fff;letter-spacing:-.4px}
.logo-sub{font-size:10px;color:rgba(255,255,255,.32);margin-top:3px;padding-left:46px}
.nav{flex:1;padding:12px 10px}
.nav-sec{font-size:9.5px;letter-spacing:1.2px;color:rgba(255,255,255,.22);text-transform:uppercase;padding:14px 12px 5px}
.nb{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:9px;cursor:pointer;font-size:13px;color:rgba(255,255,255,.52);transition:all .14s;border:none;background:none;width:100%;text-align:left;font-family:var(--font);margin-bottom:1px}
.nb i{width:16px;text-align:center;font-size:13px;flex-shrink:0}
.nb:hover{background:rgba(255,255,255,.07);color:#fff}
.nb.on{background:rgba(0,201,167,.15);color:var(--mint);font-weight:500}
.nb .nbadge{margin-left:auto;background:var(--rose);color:#fff;font-size:9px;font-weight:700;padding:2px 6px;border-radius:20px}
.user-box{margin:10px;padding:12px 13px;background:rgba(255,255,255,.05);border-radius:var(--r);border:1px solid rgba(255,255,255,.07)}
.user-row{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.u-av{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--mint),#0ea5e9);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;color:#fff}
.u-name{font-size:13px;font-weight:600;color:#fff}
.u-meta{font-size:10.5px;color:rgba(255,255,255,.38);margin-top:1px}
.u-pill{display:inline-flex;align-items:center;gap:5px;font-size:10px;padding:3px 9px;border-radius:20px;background:rgba(0,201,167,.14);color:var(--mint);font-weight:500}
.u-dot{width:5px;height:5px;border-radius:50%;background:var(--mint)}

/* ── TOPBAR ── */
.topbar{height:var(--topbar);background:var(--card);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 26px;position:sticky;top:0;z-index:40}
.topbar-left{display:flex;align-items:center;gap:12px}
.page-title{font-size:18px;font-weight:700;color:var(--text);letter-spacing:-.3px}
.topbar-right{display:flex;align-items:center;gap:9px}
.icon-btn{width:34px;height:34px;border-radius:8px;background:var(--bg);border:1px solid
var(--border);cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text2);font-size:13px;position:relative;transition:all .13s}
.icon-btn:hover{background:var(--border)}
.notif-pip{position:absolute;top:6px;right:6px;width:6px;height:6px;background:var(--rose);border-radius:50%;border:1.5px solid var(--card)}

/* ── BUTTONS ── */
.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 15px;border-radius:8px;border:none;cursor:pointer;font-size:13px;font-family:var(--font);font-weight:500;transition:all .13s;white-space:nowrap}
.btn i{font-size:11px}
.btn-mint{background:var(--mint);color:#fff}.btn-mint:hover{background:var(--mint-dk)}
.btn-ghost{background:transparent;color:var(--text2);border:1px solid var(--border)}.btn-ghost:hover{background:var(--bg)}
.btn-navy{background:var(--navy);color:#fff}.btn-navy:hover{background:var(--navy2)}
.btn-rose{background:var(--rose);color:#fff}.btn-rose:hover{background:#e0284a}
.btn-purple{background:var(--purple);color:#fff}.btn-purple:hover{background:#6d28d9}
.btn-amber{background:var(--amber);color:#fff}.btn-amber:hover{background:#d97706}
.btn-sm{padding:6px 12px;font-size:12px}

/* ── CONTENT + PAGES ── */
.content{padding:22px 26px;flex:1}
.page{display:none;animation:fadeUp .2s ease}
.page.on{display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

/* ── TAGS ── */
.tag{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:500;white-space:nowrap}
.tg-green{background:var(--green-lt);color:#065f46}
.tg-amber{background:var(--amber-lt);color:#92400e}
.tg-rose{background:var(--rose-lt);color:#9f1239}
.tg-gray{background:#f1f5f9;color:#64748b}
.tg-mint{background:var(--mint-lt);color:var(--mint-dk)}
.tg-navy{background:#e8edf5;color:var(--navy)}
.tg-purple{background:var(--purple-lt);color:var(--purple)}

/* ── CARD ── */
.card{background:var(--card);border-radius:var(--r);border:1px solid var(--border);overflow:hidden}
.card-head{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.card-title{font-size:13.5px;font-weight:600;display:flex;align-items:center;gap:7px}
.card-title i{color:var(--mint)}
.card-body{padding:16px 18px}
.card-body.np{padding:0}

/* ── TABLE ── */
table{width:100%;border-collapse:collapse}
thead th{text-align:left;padding:10px 15px;font-size:10.5px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid var(--border);background:var(--bg2);white-space:nowrap}
tbody td{padding:12px 15px;font-size:13px;border-bottom:1px solid var(--border);color:var(--text);vertical-align:middle}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover td{background:var(--bg2)}
.act{background:none;border:none;cursor:pointer;color:var(--text3);padding:4px 5px;border-radius:6px;font-size:13px;transition:all .12s;font-family:var(--font)}
.act:hover{background:var(--bg);color:var(--text)}
.act.del:hover{color:var(--rose);background:var(--rose-lt)}
.act.cert-act:hover{color:var(--mint-dk);background:var(--mint-lt)}
.act.vax-act:hover{color:var(--purple);background:var(--purple-lt)}

/* ── FORMS ── */
.form-row{margin-bottom:14px}
.lbl{display:block;font-size:11px;font-weight:600;color:var(--text2);margin-bottom:5px;text-transform:uppercase;letter-spacing:.4px}
.req{color:var(--rose)}
.inp,.sel{width:100%;padding:9px 12px;border:1.5px solid var(--border);border-radius:8px;font-size:13px;font-family:var(--font);color:var(--text);background:var(--bg2);outline:none;transition:border .14s,background .14s;appearance:auto}
.inp:focus,.sel:focus{border-color:var(--mint);background:#fff;box-shadow:0 0 0 3px rgba(0,201,167,.1)}
.inp::placeholder{color:var(--text3)}
textarea.inp{resize:vertical;min-height:66px}
.inp.err{border-color:var(--rose)}
.fg2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.fg3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.icon-inp{position:relative}
.icon-inp
i{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--text3);font-size:12px;pointer-events:none}
.icon-inp .inp{padding-left:32px}
.search-wrap{display:flex;align-items:center;gap:7px;background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:7px 11px}
.search-wrap i{color:var(--text3);font-size:12px;flex-shrink:0}
.search-wrap input{border:none;background:none;outline:none;font-size:13px;font-family:var(--font);color:var(--text);width:100%}
.vtoggle{display:flex;border:1px solid var(--border);border-radius:8px;overflow:hidden}
.vbtn{padding:6px 11px;background:none;border:none;cursor:pointer;font-size:12px;color:var(--text3);transition:all .12s}
.vbtn.on{background:var(--navy);color:#fff}
.vbtn:hover:not(.on){background:var(--bg)}

/* ── STATS ── */
.stat-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}
.sbox{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:14px 16px;display:flex;align-items:center;gap:12px;transition:box-shadow .14s}
.sbox:hover{box-shadow:var(--shadow)}
.sbox-icon{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0}
.sbox-num{font-size:22px;font-weight:700;line-height:1;color:var(--text)}
.sbox-lbl{font-size:11px;color:var(--text3);margin-top:2px}

/* ══════════════════════════════
   PATIENTS 2-PANEL
══════════════════════════════ */
.pat-toolbar{display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap}
.pat-workspace{display:grid;grid-template-columns:1fr;gap:16px;align-items:start;transition:grid-template-columns .25s}
.pat-workspace.has-panel{grid-template-columns:1fr 440px}
.pat-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
.pcard{background:var(--card);border:1.5px solid var(--border);border-radius:var(--r);padding:16px;cursor:pointer;transition:all .17s;position:relative}
.pcard:hover{border-color:var(--mint);box-shadow:0 4px 18px rgba(0,201,167,.1);transform:translateY(-2px)}
.pcard.active{border-color:var(--mint);background:linear-gradient(135deg,var(--mint-lt),#fff)}
.pcard.active::before{content:'';position:absolute;top:12px;right:12px;width:8px;height:8px;border-radius:50%;background:var(--mint)}
.pc-top{display:flex;align-items:flex-start;gap:11px;margin-bottom:10px}
.pc-av{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#fff;flex-shrink:0}
.pc-name{font-size:13.5px;font-weight:600;line-height:1.2}
.pc-id{font-size:10px;color:var(--text3);font-family:monospace;margin-top:2px}
.pc-meta{font-size:11px;color:var(--text2);margin-top:2px}
.pc-rows{display:flex;flex-direction:column;gap:4px;margin-bottom:10px}
.pc-row{display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--text2)}
.pc-row i{color:var(--text3);width:11px;font-size:10px;flex-shrink:0}
.pc-foot{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--border);padding-top:9px}
.pc-vcount{font-size:11px;color:var(--text3);display:flex;align-items:center;gap:5px}
.pc-vcount b{font-size:15px;font-weight:700;color:var(--text)}

/* ── RIGHT PANEL ── */
.pat-panel{background:var(--card);border:1px solid var(--border);border-radius:var(--r);box-shadow:var(--shadow2);position:sticky;top:calc(var(--topbar) + 14px);max-height:calc(100vh - var(--topbar) - 30px);overflow-y:auto;animation:slideIn .22s ease}
@keyframes slideIn{from{opacity:0;transform:translateX(18px)}to{opacity:1;transform:translateX(0)}}
.panel-head{display:flex;align-items:center;justify-content:space-between;padding:15px 20px;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--card);z-index:5}
.panel-title{font-size:14px;font-weight:700;display:flex;align-items:center;gap:8px}
.panel-title i{color:var(--mint)}
.panel-x{width:26px;height:26px;border-radius:7px;background:var(--bg);border:1px solid
var(--border);cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text3);font-size:12px;transition:all .12s}
.panel-x:hover{background:var(--rose-lt);color:var(--rose);border-color:#fecdd3}
.prof-banner{background:linear-gradient(130deg,var(--navy),var(--navy3));padding:18px 20px;display:flex;align-items:center;gap:13px;position:relative;overflow:hidden}
.prof-banner::after{content:'';position:absolute;top:-24px;right:-24px;width:90px;height:90px;background:rgba(0,201,167,.12);border-radius:50%}
.prof-av{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700;color:#fff;flex-shrink:0;border:2px solid rgba(255,255,255,.2)}
.prof-name{font-size:16px;font-weight:700;color:#fff;line-height:1.2}
.prof-sub{font-size:11.5px;color:rgba(255,255,255,.5);margin-top:3px}
.prof-id{font-size:10px;color:rgba(255,255,255,.3);font-family:monospace;margin-top:2px}
.ptabs{display:flex;border-bottom:1px solid var(--border);overflow-x:auto}
.ptab{padding:10px 13px;border:none;background:none;cursor:pointer;font-size:12px;font-family:var(--font);color:var(--text3);border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .14s;display:flex;align-items:center;gap:5px;white-space:nowrap;flex-shrink:0}
.ptab i{font-size:11px}
.ptab.on{color:var(--mint-dk);border-bottom-color:var(--mint);font-weight:600}
.ptab:hover:not(.on){color:var(--text)}
.ptab-body{display:none;padding:16px 20px}
.ptab-body.on{display:block;animation:fadeUp .15s}
.ifield-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
.ifield{background:var(--bg2);border-radius:8px;padding:10px 12px}
.ifield.full{grid-column:1/-1}
.ifield-lbl{font-size:9.5px;color:var(--text3);text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px}
.ifield-val{font-size:12.5px;font-weight:500;color:var(--text);word-break:break-word}
.allergy-alert{background:var(--rose-lt);border:1px solid #fecdd3;border-radius:8px;padding:10px 13px;font-size:12px;color:var(--rose);display:flex;align-items:flex-start;gap:8px;margin-top:6px}
.allergy-alert i{flex-shrink:0;margin-top:1px}
.prof-actions{display:flex;gap:8px;padding:14px 20px;border-top:1px solid var(--border);flex-wrap:wrap;position:sticky;bottom:0;background:var(--card)}

/* ── VACCINE ROWS in profile tab ── */
.vax-row-item{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--bg2);border-radius:10px;margin-bottom:8px;border:1px solid var(--border);transition:box-shadow .12s}
.vax-row-item:hover{box-shadow:var(--shadow)}
.vax-row-item.overdue{background:var(--rose-lt);border-color:#fecdd3}
.vri-dot{width:9px;height:9px;border-radius:50%;background:var(--mint);flex-shrink:0}
.vri-dot.overdue{background:var(--rose)}
.vri-dot.pending{background:var(--amber)}
.vri-info{flex:1;min-width:0}
.vri-name{font-size:12.5px;font-weight:600;color:var(--text)}
.vri-dose{font-size:11px;color:var(--text3);margin-top:1px}
.vri-date{font-size:11px;color:var(--text3)}
.vri-facility{font-size:10.5px;color:var(--text3)}
.vri-actions{display:flex;gap:2px;flex-shrink:0}

/* form steps */
.steps-bar{display:flex;align-items:center;padding:13px 20px;border-bottom:1px solid var(--border);background:var(--bg2)}
.step{display:flex;align-items:center;gap:7px;opacity:.4;transition:opacity .2s;cursor:pointer}
.step.on,.step.done{opacity:1}
.step-num{width:24px;height:24px;border-radius:50%;background:var(--border2);display:flex;align-items:center;justify-content:center;font-size:10.5px;font-weight:700;color:var(--text3);transition:all .2s;flex-shrink:0}
.step.on .step-num{background:var(--mint);color:#fff}
.step.done .step-num{background:var(--green);color:#fff}
.step-lbl{font-size:11.5px;font-weight:500;color:var(--text2);white-space:nowrap}
.step.on .step-lbl{color:var(--mint-dk);font-weight:600}
.step-line{flex:1;height:2px;background:var(--border);margin:0 6px;min-width:10px;transition:background .3s}
.step-line.done{background:var(--green)}
.step-body{display:none;padding:18px
20px}
.step-body.on{display:block;animation:fadeUp .16s}
.sec-label{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:var(--text3);margin-bottom:14px;padding-bottom:8px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:7px}
.sec-label i{color:var(--mint)}
.step-nav{display:flex;align-items:center;justify-content:space-between;margin-top:16px;padding-top:14px;border-top:1px solid var(--border)}

/* ══════════════════════════════
   ADD VACCINE MODAL
══════════════════════════════ */
.modal-backdrop{position:fixed;inset:0;background:rgba(11,31,58,.55);display:flex;align-items:center;justify-content:center;z-index:200;backdrop-filter:blur(4px);opacity:0;pointer-events:none;transition:opacity .2s}
.modal-backdrop.open{opacity:1;pointer-events:all}
.modal-box{background:var(--card);border-radius:16px;width:560px;max-width:95vw;max-height:90vh;overflow-y:auto;box-shadow:var(--shadow2);transform:translateY(20px);transition:transform .2s;display:flex;flex-direction:column}
.modal-backdrop.open .modal-box{transform:translateY(0)}
.modal-head{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--card);z-index:2}
.modal-head-left{display:flex;align-items:center;gap:12px}
.modal-head-icon{width:38px;height:38px;border-radius:10px;background:var(--purple-lt);display:flex;align-items:center;justify-content:center;color:var(--purple);font-size:16px;flex-shrink:0}
.modal-title{font-size:16px;font-weight:700}
.modal-subtitle{font-size:12px;color:var(--text3);margin-top:2px}
.modal-close{width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:var(--bg);cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text3);font-size:14px;transition:all .12s}
.modal-close:hover{background:var(--rose-lt);color:var(--rose);border-color:#fecdd3}
.modal-body{padding:24px;flex:1}
.modal-footer{padding:16px 24px;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:10px;background:var(--bg2);position:sticky;bottom:0}
.modal-footer-left{font-size:12px;color:var(--text3)}

/* vaccine status selector */
.vax-status-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:6px}
.vstatus-opt{padding:10px 8px;border-radius:9px;border:1.5px solid var(--border);cursor:pointer;text-align:center;transition:all .14s;font-size:12px;font-weight:500;color:var(--text2)}
.vstatus-opt:hover{border-color:var(--mint-mid)}
.vstatus-opt.on{border-color:var(--mint);background:var(--mint-lt);color:var(--mint-dk)}
.vstatus-opt.rose.on{border-color:var(--rose);background:var(--rose-lt);color:var(--rose)}
.vstatus-opt.amber.on{border-color:var(--amber);background:var(--amber-lt);color:#92400e}
.vstatus-opt i{display:block;font-size:16px;margin-bottom:4px}

/* divider */
.divider{height:1px;background:var(--border);margin:16px 0}

/* ══════════════════════════════
   CERTIFICATES PAGE
══════════════════════════════ */
.cert-page-layout{display:grid;grid-template-columns:320px 1fr;gap:20px;align-items:start}
.cert-left-panel{background:var(--card);border:1px solid var(--border);border-radius:var(--r);overflow:hidden;position:sticky;top:calc(var(--topbar)+14px);max-height:calc(100vh - var(--topbar) - 30px);display:flex;flex-direction:column}
.clp-head{padding:14px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.clp-search{padding:10px 12px;border-bottom:1px solid var(--border);flex-shrink:0}
.clp-scroll{overflow-y:auto;flex:1}
.cpr{display:flex;align-items:center;gap:10px;padding:11px 14px;border-bottom:1px solid var(--border);cursor:pointer;transition:background .13s}
.cpr:last-child{border-bottom:none}
.cpr:hover{background:var(--bg2)}
.cpr.on{background:var(--mint-lt);border-left:3px solid
var(--mint)}
.cpr-av{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;flex-shrink:0}
.cpr-name{font-size:13px;font-weight:600}
.cpr-id{font-size:10px;color:var(--text3);font-family:monospace}
.cpr-right{margin-left:auto;text-align:right}
.cpr-vcount{font-size:10.5px;color:var(--mint-dk);font-weight:600}

/* cert preview */
.cert-right-area{display:flex;flex-direction:column;gap:14px}
.cert-toolbar{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:13px 18px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.cert-tb-left{font-size:14px;font-weight:600;display:flex;align-items:center;gap:8px}
.cert-tb-left i{color:var(--mint)}
.cert-tb-right{display:flex;gap:8px;flex-wrap:wrap}

/* THE CERTIFICATE */
.cert-doc{background:var(--card);border-radius:16px;border:2px solid var(--mint);padding:36px;box-shadow:var(--shadow2);position:relative;overflow:hidden}
.cert-doc::before{content:'';position:absolute;top:-60px;right:-60px;width:200px;height:200px;background:var(--mint-lt);border-radius:50%;z-index:0}
.cert-doc::after{content:'';position:absolute;bottom:-50px;left:-50px;width:160px;height:160px;background:#eef5ff;border-radius:50%;z-index:0}
.cert-doc-inner{position:relative;z-index:1}
.cert-watermark{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:0;pointer-events:none;opacity:.035;font-size:90px;color:var(--navy);font-weight:900;letter-spacing:-4px;transform:rotate(-25deg);white-space:nowrap}
.cert-hdr{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:26px}
.cert-brand-row{display:flex;align-items:center;gap:12px}
.cert-brand-ico{width:46px;height:46px;background:var(--mint);border-radius:12px;display:flex;align-items:center;justify-content:center}
.cert-brand-ico i{color:#fff;font-size:20px}
.cert-brand-name{font-size:17px;font-weight:700;color:var(--navy)}
.cert-brand-org{font-size:11px;color:var(--text3);margin-top:2px}
.cert-qr{width:74px;height:74px;background:var(--navy);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:32px;color:#fff}
.cert-title{font-family:var(--serif);font-size:28px;font-style:italic;color:var(--navy);margin-bottom:5px}
.cert-sub{font-size:12px;color:var(--text3);margin-bottom:22px;line-height:1.6;max-width:500px}
.cert-person{display:flex;align-items:center;gap:16px;background:var(--bg);border-radius:var(--r);padding:16px 18px;margin-bottom:22px}
.cert-pers-av{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:19px;font-weight:700;color:#fff;flex-shrink:0}
.cert-pers-name{font-size:20px;font-weight:700;color:var(--text)}
.cert-pers-meta{font-size:12px;color:var(--text2);margin-top:3px}
.cert-pers-id{font-size:11px;color:var(--text3);font-family:monospace;margin-top:2px}
.cert-stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-bottom:22px;background:var(--bg2);border-radius:var(--r);overflow:hidden;border:1px solid var(--border)}
.cstat{text-align:center;padding:14px 12px;border-right:1px solid var(--border)}
.cstat:last-child{border-right:none}
.cstat-num{font-size:24px;font-weight:700;color:var(--mint-dk);line-height:1}
.cstat-lbl{font-size:10.5px;color:var(--text3);margin-top:3px}
.cert-vax-section-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--text3);margin-bottom:12px;display:flex;align-items:center;gap:7px}
.cert-vax-section-title i{color:var(--mint)}
.cert-vax-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:22px}
.cert-vax-card{background:var(--bg2);border-radius:10px;padding:12px 14px;border-left:3px solid
var(--mint)}
.cert-vax-card.overdue{border-left-color:var(--rose);background:var(--rose-lt)}
.cvc-name{font-size:12.5px;font-weight:600;color:var(--text)}
.cvc-dose{font-size:10.5px;color:var(--mint-dk);font-weight:700;margin-top:2px}
.cvc-dose.overdue{color:var(--rose)}
.cvc-meta{font-size:11px;color:var(--text3);margin-top:3px;display:flex;flex-direction:column;gap:1px}
.cert-allergy{background:var(--rose-lt);border:1px solid #fecdd3;border-radius:10px;padding:12px 16px;font-size:12px;color:var(--rose);margin-bottom:20px;display:flex;gap:8px;align-items:center}
.cert-footer{display:flex;align-items:flex-end;justify-content:space-between;border-top:1px solid var(--border);padding-top:18px;gap:20px}
.cert-footer-info{font-size:11px;color:var(--text3);line-height:1.7}
.cert-footer-info strong{color:var(--text2)}
.cert-stamp{padding:9px 18px;border-radius:20px;font-size:11.5px;font-weight:700;letter-spacing:.5px;flex-shrink:0}
.cert-stamp.verified{background:var(--mint-lt);border:1px solid var(--mint-mid);color:var(--mint-dk)}
.cert-stamp.incomplete{background:var(--amber-lt);border:1px solid var(--amber);color:#92400e}
.cert-placeholder{text-align:center;padding:72px 24px}
.cert-placeholder i{font-size:60px;color:var(--border2);margin-bottom:18px;display:block}
.cert-placeholder h3{font-size:17px;font-weight:600;color:var(--text2);margin-bottom:6px}
.cert-placeholder p{font-size:13px;color:var(--text3)}

/* toast */
.toast-pop{position:fixed;bottom:22px;right:22px;background:var(--navy);color:#fff;padding:11px 18px;border-radius:10px;font-size:13px;font-weight:500;display:flex;align-items:center;gap:9px;z-index:999;box-shadow:var(--shadow2);animation:fadeUp .2s}
.toast-pop i{color:var(--mint)}
.toast-pop.err-toast{background:var(--rose)}
.toast-pop.err-toast i{color:#fff}

/* empty */
.empty{text-align:center;padding:44px 20px;color:var(--text3)}
.empty i{font-size:38px;margin-bottom:12px;display:block;opacity:.3}
.empty p{font-size:13.5px;font-weight:500}
.empty small{font-size:12px;opacity:.7;display:block;margin-top:3px}

/* scrollbar */
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:10px}

/* print */
@media print{
  .sidebar,.topbar,.pat-toolbar,.cert-toolbar,.cert-left-panel,.prof-actions,.panel-head,.cert-tb-right,#modal-vax{display:none!important}
  .main{margin-left:0!important}
  .cert-page-layout{grid-template-columns:1fr!important}
  .cert-doc{box-shadow:none;border:1.5px solid var(--mint);page-break-inside:avoid}
  body{background:#fff}
}

@media(max-width:1100px){.pat-workspace.has-panel{grid-template-columns:1fr 400px}.cert-page-layout{grid-template-columns:280px 1fr}}
@media(max-width:900px){
  .sidebar{transform:translateX(-100%)}.sidebar.open{transform:translateX(0)}
  .main{margin-left:0}
  .stat-strip{grid-template-columns:1fr 1fr}
  .pat-workspace.has-panel{grid-template-columns:1fr}
  .pat-panel{position:fixed;top:0;right:0;bottom:0;width:100%;max-width:440px;border-radius:0;z-index:60;max-height:100vh}
  .cert-page-layout{grid-template-columns:1fr}
  .cert-left-panel{position:static;max-height:300px}
}
@media(max-width:580px){.stat-strip{grid-template-columns:1fr}.fg2,.fg3{grid-template-columns:1fr}.pat-cards{grid-template-columns:1fr}.cert-vax-grid{grid-template-columns:1fr}.cert-stats-row{grid-template-columns:1fr 1fr}}
</style>
</head>
<body>
<div class="app">

<!-- SIDEBAR -->
<aside class="sidebar" id="sidebar">
  <div class="logo">
    <div class="logo-row">
      <div class="logo-mark"><i class="fas fa-syringe"></i></div>
      <div class="logo-text">VaxTrack</div>
    </div>
    <div class="logo-sub">Immunisation Management System</div>
  </div>
  <nav class="nav">
    <span class="nav-sec">Main</span>
    <button class="nb" onclick="goPage('patients')"><i class="fas fa-users"></i>Patients</button>
    <button class="nb" onclick="goPage('certificates')"><i class="fas fa-certificate"></i>Certificates</button>
    <button class="nb" onclick="goPage('records')"><i class="fas
fa-file-medical"></i>Vaccine Records</button>
    <button class="nb" onclick="goPage('schedule')"><i class="fas fa-calendar-check"></i>Scheduler</button>
    <span class="nav-sec">System</span>
    <button class="nb" onclick="goPage('notifications')"><i class="fas fa-bell"></i>Notifications<span class="nbadge">3</span></button>
    <button class="nb" onclick="goPage('admin')"><i class="fas fa-shield-alt"></i>Admin Panel</button>
  </nav>
  <div class="user-box">
    <div class="user-row">
      <div class="u-av">AD</div>
      <div><div class="u-name">Admin</div><div class="u-meta">VaxTrack System</div></div>
    </div>
    <div class="u-pill"><div class="u-dot"></div>System Active</div>
  </div>
</aside>

<!-- MAIN -->
<div class="main">
  <header class="topbar">
    <div class="topbar-left">
      <button class="icon-btn" id="menu-btn" onclick="document.getElementById('sidebar').classList.toggle('open')" style="display:none"><i class="fas fa-bars"></i></button>
      <h1 class="page-title" id="page-title">Patients</h1>
    </div>
    <div class="topbar-right">
      <button class="icon-btn" onclick="goPage('notifications')"><i class="fas fa-bell"></i><div class="notif-pip"></div></button>
      <button class="btn btn-ghost btn-sm" onclick="goPage('certificates')"><i class="fas fa-certificate"></i>Certificates</button>
      <button class="btn btn-mint btn-sm" onclick="openPatientForm(null)"><i class="fas fa-user-plus"></i>Add Patient</button>
    </div>
  </header>

  <div class="content">

    <!-- ══ PATIENTS ══ -->
    <section class="page on" id="page-patients">
      <div class="pat-toolbar">
        <div class="search-wrap" style="width:220px">
          <i class="fas fa-search"></i>
          <input type="text" placeholder="Search name, ID, phone…" oninput="filterPat(this.value)">
        </div>
        <select class="inp" style="width:140px;margin:0" onchange="filterStatus(this.value)">
          <option value="">All Statuses</option>
          <option value="Active">Active</option>
          <option value="Overdue">Overdue</option>
          <option value="Follow-up">Follow-up</option>
          <option value="Inactive">Inactive</option>
        </select>
        <div class="vtoggle">
          <button class="vbtn on" id="vb-card" onclick="setView('card')" title="Cards"><i class="fas fa-th-large"></i></button>
          <button class="vbtn" id="vb-table" onclick="setView('table')" title="Table"><i class="fas fa-list"></i></button>
        </div>
        <div style="flex:1"></div>
        <button class="btn btn-mint" onclick="openPatientForm(null)"><i class="fas fa-user-plus"></i>Add Patient</button>
      </div>

      <div class="stat-strip" id="pat-stats"></div>

      <div class="pat-workspace" id="pat-workspace">
        <div id="pat-list-col">
          <div id="cards-view"><div class="pat-cards" id="pat-cards"></div></div>
          <div id="table-view" style="display:none">
            <div class="card"><div class="card-body np">
              <table><thead><tr><th>Patient</th><th>Age/Sex</th><th>Blood</th><th>Phone</th><th>Vaccines</th><th>Status</th><th></th></tr></thead>
              <tbody id="pat-tbody"></tbody></table>
            </div></div>
          </div>
        </div>

        <!-- RIGHT PANEL (profile / patient form) -->
        <div class="pat-panel" id="pat-panel" style="display:none">

          <!-- PROFILE VIEW -->
          <div id="panel-profile" style="display:none">
            <div class="panel-head">
              <div class="panel-title"><i class="fas fa-user-circle"></i><span id="pp-title">Profile</span></div>
              <button class="panel-x" onclick="closePanel()"><i class="fas fa-times"></i></button>
            </div>
            <div id="pp-body"></div>
            <div class="prof-actions" id="pp-actions"></div>
          </div>

          <!-- PATIENT FORM -->
          <div id="panel-form" style="display:none">
            <div class="panel-head">
              <div class="panel-title"><i class="fas fa-user-edit"></i><span id="pf-title">New Patient</span></div>
<button class="panel-x" onclick="closePanel()"><i class="fas fa-times"></i></button>
            </div>
            <div class="steps-bar">
              <div class="step on" id="st1" onclick="goStep(1)"><div class="step-num">1</div><div class="step-lbl">Personal</div></div>
              <div class="step-line" id="sl1"></div>
              <div class="step" id="st2" onclick="goStep(2)"><div class="step-num">2</div><div class="step-lbl">Contact</div></div>
              <div class="step-line" id="sl2"></div>
              <div class="step" id="st3" onclick="goStep(3)"><div class="step-num">3</div><div class="step-lbl">Medical</div></div>
            </div>
            <div class="step-body on" id="sb1">
              <div class="sec-label"><i class="fas fa-id-card"></i>Personal Information</div>
              <div class="fg2">
                <div class="form-row"><label class="lbl">First Name <span class="req">*</span></label><input class="inp" id="f-fname" placeholder="First name" oninput="autosave()"></div>
                <div class="form-row"><label class="lbl">Last Name <span class="req">*</span></label><input class="inp" id="f-lname" placeholder="Last name" oninput="autosave()"></div>
              </div>
              <div class="fg2">
                <div class="form-row"><label class="lbl">Date of Birth <span class="req">*</span></label><input class="inp" type="date" id="f-dob" oninput="autosave()"></div>
                <div class="form-row"><label class="lbl">Gender</label><select class="sel" id="f-gender" onchange="autosave()"><option>Male</option><option>Female</option><option>Other</option></select></div>
              </div>
              <div class="fg2">
                <div class="form-row"><label class="lbl">Blood Group</label><select class="sel" id="f-blood" onchange="autosave()"><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select></div>
                <div class="form-row"><label class="lbl">Status</label><select class="sel" id="f-status" onchange="autosave()"><option>Active</option><option>Follow-up</option><option>Overdue</option><option>Inactive</option></select></div>
              </div>
              <div class="form-row"><label class="lbl">Assigned Physician</label><div class="icon-inp"><i class="fas fa-user-md"></i><input class="inp" id="f-doctor" placeholder="Dr. Name" oninput="autosave()"></div></div>
              <div class="step-nav"><span></span><button class="btn btn-mint" onclick="goStep(2)">Next <i class="fas fa-arrow-right"></i></button></div>
            </div>
            <div class="step-body" id="sb2">
              <div class="sec-label"><i class="fas fa-address-card"></i>Contact Details</div>
              <div class="form-row"><label class="lbl">Phone</label><div class="icon-inp"><i class="fas fa-phone"></i><input class="inp" id="f-phone" placeholder="+91 99999 00000" oninput="autosave()"></div></div>
              <div class="form-row"><label class="lbl">Email</label><div class="icon-inp"><i class="fas fa-envelope"></i><input class="inp" type="email" id="f-email" placeholder="patient@email.com" oninput="autosave()"></div></div>
              <div class="form-row"><label class="lbl">Address</label><textarea class="inp" id="f-address" placeholder="Street, City, State, PIN" rows="2" oninput="autosave()"></textarea></div>
              <div class="form-row"><label class="lbl">Emergency Contact</label><div class="icon-inp"><i class="fas fa-user-shield"></i><input class="inp" id="f-emergency" placeholder="Name — Phone" oninput="autosave()"></div></div>
              <div class="step-nav">
                <button class="btn btn-ghost" onclick="goStep(1)"><i class="fas fa-arrow-left"></i> Back</button>
                <button class="btn btn-mint" onclick="goStep(3)">Next <i class="fas fa-arrow-right"></i></button>
              </div>
            </div>
            <div class="step-body" id="sb3">
              <div class="sec-label"><i class="fas
fa-heartbeat"></i>Medical Information</div>
              <div class="form-row"><label class="lbl">Known Allergies</label><input class="inp" id="f-allergies" placeholder="e.g. Penicillin — or — None" oninput="autosave()"></div>
              <div class="form-row"><label class="lbl">Medical Conditions</label><input class="inp" id="f-conditions" placeholder="e.g. Diabetes — or — None" oninput="autosave()"></div>
              <div class="form-row"><label class="lbl">Previous Vaccines (notes)</label><textarea class="inp" id="f-prevvax" placeholder="e.g. BCG at birth, OPV 3 doses…" rows="2" oninput="autosave()"></textarea></div>
              <div class="form-row"><label class="lbl">Clinical Notes</label><textarea class="inp" id="f-notes" placeholder="Notes for healthcare staff…" rows="2" oninput="autosave()"></textarea></div>
              <div id="f-autosave-note" style="font-size:11px;color:var(--text3);margin-top:4px;display:none"><i class="fas fa-check-circle" style="color:var(--green)"></i> Draft auto-saved</div>
              <div class="step-nav">
                <button class="btn btn-ghost" onclick="goStep(2)"><i class="fas fa-arrow-left"></i> Back</button>
                <button class="btn btn-mint" onclick="savePatient()"><i class="fas fa-save"></i> Save Patient</button>
              </div>
            </div>
          </div>

        </div><!-- /pat-panel -->
      </div>
    </section>

    <!-- ══ CERTIFICATES ══ -->
    <section class="page" id="page-certificates">
      <div class="cert-page-layout">
        <div class="cert-left-panel">
          <div class="clp-head">
            <span style="font-size:13px;font-weight:600"><i class="fas fa-users" style="color:var(--mint);margin-right:6px"></i>Patients</span>
            <span class="tag tg-mint" id="cert-count">0</span>
          </div>
          <div class="clp-search"><div class="search-wrap"><i class="fas fa-search"></i><input type="text" placeholder="Search…" oninput="filterCertList(this.value)"></div></div>
          <div class="clp-scroll" id="cert-pat-list"></div>
        </div>
        <div class="cert-right-area">
          <div class="cert-toolbar" id="cert-toolbar" style="display:none">
            <div class="cert-tb-left"><i class="fas fa-certificate"></i><span id="cert-bar-name">Certificate</span></div>
            <div class="cert-tb-right">
              <button class="btn btn-ghost btn-sm" onclick="window.print()"><i class="fas fa-print"></i>Print</button>
              <button class="btn btn-ghost btn-sm" onclick="toast('Link copied to clipboard')"><i class="fas fa-share-alt"></i>Share</button>
              <button class="btn btn-ghost btn-sm" onclick="toast('QR Code generated')"><i class="fas fa-qrcode"></i>QR Code</button>
              <button class="btn btn-mint btn-sm" onclick="toast('Certificate PDF downloading…')"><i class="fas fa-download"></i>Download PDF</button>
            </div>
          </div>
          <div id="cert-display">
            <div class="cert-placeholder">
              <i class="fas fa-certificate"></i>
              <h3>Select a Patient</h3>
              <p>Choose a patient from the list to view and download their vaccination certificate</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="page" id="page-records"><div class="empty"><i class="fas fa-file-medical"></i><p>Vaccine Records</p></div></section>
    <section class="page" id="page-schedule"><div class="empty"><i class="fas fa-calendar-check"></i><p>Scheduler</p></div></section>
    <section class="page" id="page-notifications"><div class="empty"><i class="fas fa-bell"></i><p>Notifications</p></div></section>
    <section class="page" id="page-admin"><div class="empty"><i class="fas fa-shield-alt"></i><p>Admin Panel</p></div></section>

  </div><!-- /content -->
</div><!-- /main -->
</div><!-- /app -->

<!-- ══ ADD VACCINE MODAL ══ -->
<div class="modal-backdrop" id="modal-vax" onclick="handleBackdropClick(event)">
  <div class="modal-box">
    <div class="modal-head">
      <div
class="modal-head-left">
        <div class="modal-head-icon"><i class="fas fa-syringe"></i></div>
        <div>
          <div class="modal-title">Add Vaccine</div>
          <div class="modal-subtitle" id="vax-modal-patient-name">Patient name</div>
        </div>
      </div>
      <button class="modal-close" onclick="closeVaxModal()"><i class="fas fa-times"></i></button>
    </div>

    <div class="modal-body">
      <!-- Vaccine name + category -->
      <div class="fg2">
        <div class="form-row" style="grid-column:1/-1">
          <label class="lbl">Vaccine Name <span class="req">*</span></label>
          <div class="icon-inp"><i class="fas fa-vial"></i><input class="inp" id="v-name" placeholder="e.g. COVID-19 (Covishield), MMR, Hepatitis B…"></div>
        </div>
      </div>
      <div class="fg2">
        <div class="form-row">
          <label class="lbl">Dose / Description <span class="req">*</span></label>
          <select class="sel" id="v-dose">
            <option value="">— Select dose —</option>
            <option>1st Dose</option><option>2nd Dose</option><option>3rd Dose</option>
            <option>4th Dose</option><option>Booster</option><option>Annual</option>
            <option>Complete Series</option><option>At Birth</option><option>Single Dose</option>
          </select>
        </div>
        <div class="form-row">
          <label class="lbl">Lot Number</label>
          <input class="inp" id="v-lot" placeholder="e.g. AB1234 (optional)">
        </div>
      </div>

      <div class="divider"></div>

      <!-- Date + Facility + Doctor -->
      <div class="fg3">
        <div class="form-row">
          <label class="lbl">Date Administered <span class="req">*</span></label>
          <input class="inp" type="date" id="v-date">
        </div>
        <div class="form-row">
          <label class="lbl">Next Due Date</label>
          <input class="inp" type="date" id="v-next">
        </div>
        <div class="form-row">
          <label class="lbl">Category</label>
