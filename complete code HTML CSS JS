function age(dob){const d=new Date(dob),n=new Date();let a=n.getFullYear()-d.getFullYear();if(n.getMonth()<d.getMonth()||(n.getMonth()===d.getMonth()&&n.getDate()<d.getDate()))a--;return isNaN(a)||a<0?'?':a;}
function ini(p){return((p.fname||'?')[0]+(p.lname||'?')[0]).toUpperCase();}
function stTag(s){return s==='Active'?'tg-green':s==='Overdue'?'tg-rose':s==='Follow-up'?'tg-amber':'tg-gray';}
function vDoneCount(id){return(vaxDB[id]||[]).filter(v=>v.status==='done').length;}
function getFiltered(){
  return patients.filter(p=>{
    const q=searchQ.toLowerCase();
    const mq=!q||(p.fname+' '+p.lname).toLowerCase().includes(q)||p.id.toLowerCase().includes(q)||(p.phone||'').includes(q);
    return mq&&(!statusF||p.status===statusF);
  });
}
function toast(msg,type='ok'){
  document.querySelectorAll('.toast-pop').forEach(t=>t.remove());
  const
t=document.createElement('div');
  t.className='toast-pop'+(type==='err'?' err-toast':'');
  t.innerHTML=`<i class="fas ${type==='err'?'fa-times-circle':'fa-check-circle'}"></i>${msg}`;
  document.body.appendChild(t);
  setTimeout(()=>t.remove(),3200);
}
function newPID(){return 'PT-'+String(Date.now()).slice(-6);}
