function swTab(tab,btn){
  const panel=btn.closest('.pat-panel');
  panel.querySelectorAll('.ptab').forEach(b=>b.classList.remove('on'));
  panel.querySelectorAll('.ptab-body').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on');
  const tb=panel.querySelector('#tb-'+tab);
  if(tb)tb.classList.add('on');
}

function removeVax(patId,vaxId){
  if(!confirm('Remove this vaccine record?'))return;
  vaxDB[patId]=(vaxDB[patId]||[]).filter(v=>v.id!==vaxId);
  persistVax();
  renderAll();
  openProfile(patId);
  if(activeCertId===patId)showCertFor(patId);
  toast('Vaccine record removed');
}

// ════════════════════════════════════════
//  ADD VACCINE MODAL
// ════════════════════════════════════════
function
openVaxModal(patId){
  vaxModalPatientId=patId;
  vaxStatus='done';
  const p=patients.find(x=>x.id===patId);
  document.getElementById('vax-modal-patient-name').textContent=p?p.fname+' '+p.lname+' · '+p.id:'';
  const done=(vaxDB[patId]||[]).filter(v=>v.status==='done').length;
  document.getElementById('vax-modal-footer-info').textContent=done+' vaccine'+(done!==1?'s':'')+' already on record';
  // clear form
  ['v-name','v-lot','v-next','v-notes'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('v-dose').value='';
  document.getElementById('v-date').value=new Date().toISOString().split('T')[0];
  document.getElementById('v-category').value='Routine';
  document.getElementById('v-doctor').value=(p&&p.doctor)?p.doctor:'';
  document.getElementById('v-facility').value='';
  selectVaxStatus('done');
  document.getElementById('modal-vax').classList.add('open');
  setTimeout(()=>document.getElementById('v-name').focus(),200);
}

function selectVaxStatus(s){
  vaxStatus=s;
  ['done','pending','overdue'].forEach(k=>{
    const el=document.getElementById('vs-'+k);
    if(el)el.classList.toggle('on',k===s);
  });
}

function closeVaxModal(){document.getElementById('modal-vax').classList.remove('open');}
function handleBackdropClick(e){if(e.target===document.getElementById('modal-vax'))closeVaxModal();}

function gv(id){const el=document.getElementById(id);return el?el.value.trim():'';}

function collectVax(){
  const name=gv('v-name');
  const dose=gv('v-dose');
  const dateVal=gv('v-date');
  const facility=gv('v-facility');
  if(!name){toast('Vaccine name is required','err');document.getElementById('v-name').focus();return null;}
  if(!dose){toast('Please select a dose','err');document.getElementById('v-dose').focus();return null;}
  if(!dateVal){toast('Date administered is required','err');document.getElementById('v-date').focus();return null;}
  if(!facility){toast('Healthcare facility is required','err');document.getElementById('v-facility').focus();return null;}
  const d=new Date(dateVal);
  const dateStr=d.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'});
  return{id:newVID(),name,dose,date:dateStr,facility,doctor:gv('v-doctor')||'—',lot:gv('v-lot'),category:gv('v-category'),status:vaxStatus,notes:gv('v-notes'),nextDue:gv('v-next')};
}

function saveVaccine(){
  const rec=collectVax();if(!rec)return;
  if(!vaxDB[vaxModalPatientId])vaxDB[vaxModalPatientId]=[];
  vaxDB[vaxModalPatientId].push(rec);
  persistVax();
  renderAll();
  if(activeId===vaxModalPatientId)openProfile(vaxModalPatientId);
  if(activeCertId===vaxModalPatientId)showCertFor(vaxModalPatientId);
  closeVaxModal();
  toast('Vaccine added: '+rec.name);
}

function saveVaccineAndCert(){
  const rec=collectVax();if(!rec)return;
  if(!vaxDB[vaxModalPatientId])vaxDB[vaxModalPatientId]=[];
  vaxDB[vaxModalPatientId].push(rec);
  persistVax();
  renderAll();
  closeVaxModal();
  toast('Vaccine saved — opening certificate…');
  setTimeout(()=>viewCertFor(vaxModalPatientId),300);
}

// ════════════════════════════════════════
//  PATIENT FORM (3-step)
// ════════════════════════════════════════
function openPatientForm(id){
  editingId=id;
  document.getElementById('pf-title').textContent=id?'Edit Patient':'New Patient';
  const F={fname:'',lname:'',dob:'',gender:'Male',blood:'A+',status:'Active',doctor:'',phone:'',email:'',address:'',emergency:'',allergies:'',conditions:'',prevvax:'',notes:''};
  if(id){const p=patients.find(x=>x.id===id);if(p)Object.keys(F).forEach(k=>F[k]=p[k]||'');}
  else{try{const d=JSON.parse(localStorage.getItem('vt2_draft')||'{}');Object.assign(F,d);}catch(e){}}
  Object.keys(F).forEach(k=>{const el=document.getElementById('f-'+k);if(el)el.value=F[k]||'';});
  goStep(1);showPanel('form');
  setTimeout(()=>{const el=document.getElementById('f-fname');if(el)el.focus();},100);
}

function autosave(){
  if(editingId)return;
  clearTimeout(draftTimer);
  draftTimer=setTimeout(()=>{
    const
d={};['fname','lname','dob','gender','blood','status','doctor','phone','email','address','emergency','allergies','conditions','prevvax','notes'].forEach(k=>{const el=document.getElementById('f-'+k);if(el)d[k]=el.value.trim();});
    try{localStorage.setItem('vt2_draft',JSON.stringify(d));}catch(e){}
    const n=document.getElementById('f-autosave-note');
    if(n){n.style.display='block';setTimeout(()=>n.style.display='none',2500);}
  },700);
}

function goStep(n){
  curStep=n;
  [1,2,3].forEach(i=>{
    const st=document.getElementById('st'+i),sb=document.getElementById('sb'+i),sl=document.getElementById('sl'+i);
    if(st)st.className='step'+(i===n?' on':i<n?' done':'');
    if(sb)sb.className='step-body'+(i===n?' on':'');
    if(sl)sl.className='step-line'+(i<n?' done':'');
  });
}

function savePatient(){
  const fname=gv('f-fname'),lname=gv('f-lname'),dob=gv('f-dob');
  if(!fname){toast('First name is required','err');goStep(1);document.getElementById('f-fname').classList.add('err');return;}
  if(!lname){toast('Last name is required','err');goStep(1);document.getElementById('f-lname').classList.add('err');return;}
  if(!dob){toast('Date of birth is required','err');goStep(1);document.getElementById('f-dob').classList.add('err');return;}
  ['f-fname','f-lname','f-dob'].forEach(id=>document.getElementById(id).classList.remove('err'));
  const data={fname,lname,dob,gender:gv('f-gender'),blood:gv('f-blood'),status:gv('f-status'),doctor:gv('f-doctor'),phone:gv('f-phone'),email:gv('f-email'),address:gv('f-address'),emergency:gv('f-emergency'),allergies:gv('f-allergies')||'None',conditions:gv('f-conditions')||'None',prevvax:gv('f-prevvax'),notes:gv('f-notes')};
  if(editingId){
    const idx=patients.findIndex(p=>p.id===editingId);
    if(idx>-1){patients[idx]={...patients[idx],...data};persist();toast('Patient updated — '+fname+' '+lname);renderAll();openProfile(editingId);}
  }else{
    const id=newPID();
    patients.push({id,...data,color:COLORS[patients.length%COLORS.length]});
    if(!vaxDB[id])vaxDB[id]=[];
    persist();persistVax();
    localStorage.removeItem('vt2_draft');
    toast('Patient added — '+fname+' '+lname);
    renderAll();openProfile(id);
  }
}

// ════════════════════════════════════════
//  DELETE PATIENT
// ════════════════════════════════════════
function deletePat(id){
  const p=patients.find(x=>x.id===id);if(!p)return;
  if(!confirm('Delete '+p.fname+' '+p.lname+'?\nThis will remove all their vaccine records and certificate.'))return;
  patients=patients.filter(x=>x.id!==id);
  delete vaxDB[id];
  persist();persistVax();
  if(activeId===id)closePanel();
  if(activeCertId===id){activeCertId=null;document.getElementById('cert-display').innerHTML='<div class="cert-placeholder"><i class="fas fa-certificate"></i><h3>Select a Patient</h3><p>Choose from the list to view their certificate</p></div>';document.getElementById('cert-toolbar').style.display='none';}
  renderAll();
  if(document.getElementById('page-certificates').classList.contains('on'))renderCertList();
  toast('Patient removed');
}

