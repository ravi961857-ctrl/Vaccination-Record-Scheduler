function renderCertList(){
  const q=certSearchQ.toLowerCase();
  const data=patients.filter(p=>!q||(p.fname+' '+p.lname).toLowerCase().includes(q)||p.id.toLowerCase().includes(q));
  document.getElementById('cert-count').textContent=data.length;
  document.getElementById('cert-pat-list').innerHTML=data.map(p=>`
    <div class="cpr ${activeCertId===p.id?'on':''}" onclick="showCertFor('${p.id}')">
      <div class="cpr-av" style="background:${p.color}">${ini(p)}</div>
      <div style="flex:1;min-width:0">
        <div class="cpr-name">${p.fname} ${p.lname}</div>
        <div class="cpr-id">${p.id} · ${p.blood}</div>
      </div>
      <div class="cpr-right">
        <span class="tag ${stTag(p.status)}" style="font-size:10px;padding:2px 7px">${p.status}</span>
        <div class="cpr-vcount"><i class="fas fa-syringe" style="margin-right:3px"></i>${vDoneCount(p.id)} vaccines</div>
      </div>
